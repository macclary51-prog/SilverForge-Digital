rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/roles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/roles/$(request.auth.uid)
        ).data.role == "admin"
        && get(
          /databases/$(database)/documents/roles/$(request.auth.uid)
        ).data.active == true;
    }

    function hasPublicLeadFields(data) {
      return data.keys().hasAll([
        "name",
        "business",
        "email",
        "phone",
        "service",
        "message",
        "status",
        "quoteAmount",
        "followUpDate",
        "internalNotes",
        "createdAt",
        "updatedAt"
      ])
      && data.keys().hasOnly([
        "name",
        "business",
        "email",
        "phone",
        "service",
        "message",
        "status",
        "quoteAmount",
        "followUpDate",
        "internalNotes",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasAdminLeadFields(data) {
      return data.keys().hasAll([
        "name",
        "business",
        "email",
        "phone",
        "service",
        "message",
        "status",
        "quoteAmount",
        "followUpDate",
        "internalNotes",
        "createdAt",
        "updatedAt"
      ])
      && data.keys().hasOnly([
        "name",
        "business",
        "email",
        "phone",
        "service",
        "message",
        "status",
        "quoteAmount",
        "followUpDate",
        "internalNotes",
        "createdAt",
        "updatedAt",
        "projectTitle",
        "clientProjectSummary",
        "scopeOfWork",
        "deliverables",
        "officialPrice",
        "depositAmount",
        "remainingBalance",
        "estimatedTimeline",
        "proposedStartDate",
        "proposedCompletionDate",
        "includedRevisions",
        "paymentTerms",
        "additionalTerms",
        "proposalExpirationDate",
        "clientMessage",
        "proposalStatus",
        "proposalNumber",
        "proposalCreatedAt",
        "proposalSentAt",
        "proposalAcceptedAt",
        "lastClientEmailSubject",
        "lastClientEmailBody",
        "lastClientEmailSentAt"
      ]);
    }

    function hasValidCustomerFields(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.business is string
        && data.business.size() > 0
        && data.business.size() <= 160
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.email.matches("^[^@]+@[^@]+[.][^@]+$")
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 40
        && data["service"] is string
        && data["service"] in [
          "App Development",
          "Website Development",
          "Social Media Management",
          "Content and Video Creation",
          "Digital Advertising",
          "Multiple Services"
        ]
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 5000;
    }

    function hasValidLeadStatus(data) {
      return data.status is string
        && data.status in [
          "new",
          "contacted",
          "qualified",
          "quote-sent",
          "accepted",
          "in-progress",
          "completed",
          "lost"
        ];
    }

    function isValidMoney(value) {
      return value == null
        || (
          value is number
          && value >= 0
          && value <= 100000000
        );
    }

    function isValidDateString(value) {
      return value is string
        && value.size() <= 10
        && value.matches("^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$");
    }

    function isValidOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function hasValidPrivateFields(data) {
      return hasValidLeadStatus(data)
        && isValidMoney(data.quoteAmount)
        && isValidDateString(data.followUpDate)
        && data.internalNotes is string
        && data.internalNotes.size() <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidProposalText(data) {
      return data.get("projectTitle", "") is string
        && data.get("projectTitle", "").size() <= 200
        && data.get("clientProjectSummary", "") is string
        && data.get("clientProjectSummary", "").size() <= 5000
        && data.get("scopeOfWork", "") is string
        && data.get("scopeOfWork", "").size() <= 10000
        && data.get("deliverables", "") is string
        && data.get("deliverables", "").size() <= 10000
        && data.get("estimatedTimeline", "") is string
        && data.get("estimatedTimeline", "").size() <= 200
        && data.get("paymentTerms", "") is string
        && data.get("paymentTerms", "").size() <= 5000
        && data.get("additionalTerms", "") is string
        && data.get("additionalTerms", "").size() <= 5000
        && data.get("clientMessage", "") is string
        && data.get("clientMessage", "").size() <= 10000
        && data.get("lastClientEmailSubject", "") is string
        && data.get("lastClientEmailSubject", "").size() <= 300
        && data.get("lastClientEmailBody", "") is string
        && data.get("lastClientEmailBody", "").size() <= 20000;
    }

    function hasValidProposalDates(data) {
      return isValidDateString(
          data.get("proposedStartDate", "")
        )
        && isValidDateString(
          data.get("proposedCompletionDate", "")
        )
        && isValidDateString(
          data.get("proposalExpirationDate", "")
        );
    }

    function hasValidProposalPricing(data) {
      let price = data.get("officialPrice", null);
      let deposit = data.get("depositAmount", null);
      let balance = data.get("remainingBalance", null);

      return isValidMoney(price)
        && isValidMoney(deposit)
        && isValidMoney(balance)
        && (
          (
            price == null
            && deposit == null
            && balance == null
          )
          || (
            price is number
            && (
              deposit == null
              || (
                deposit is number
                && deposit <= price
              )
            )
            && balance >= price - (
              deposit == null ? 0 : deposit
            ) - 0.01
            && balance <= price - (
              deposit == null ? 0 : deposit
            ) + 0.01
          )
        );
    }

    function hasValidProposalFields(data) {
      let revisions = data.get("includedRevisions", null);
      let proposalStatus = data.get("proposalStatus", "draft");
      let proposalNumber = data.get("proposalNumber", "");

      return hasValidProposalText(data)
        && hasValidProposalDates(data)
        && hasValidProposalPricing(data)
        && (
          revisions == null
          || (
            revisions is int
            && revisions >= 0
            && revisions <= 1000
          )
        )
        && proposalStatus is string
        && proposalStatus in [
          "draft",
          "ready",
          "sent",
          "accepted",
          "declined",
          "expired"
        ]
        && proposalNumber is string
        && proposalNumber.size() <= 30
        && proposalNumber.matches(
          "^$|^SFD-[0-9]{4}-[0-9]{4,}$"
        )
        && isValidOptionalTimestamp(
          data.get("proposalCreatedAt", null)
        )
        && isValidOptionalTimestamp(
          data.get("proposalSentAt", null)
        )
        && isValidOptionalTimestamp(
          data.get("proposalAcceptedAt", null)
        )
        && isValidOptionalTimestamp(
          data.get("lastClientEmailSentAt", null)
        );
    }

    function isValidPublicLead() {
      let data = request.resource.data;

      return hasPublicLeadFields(data)
        && hasValidCustomerFields(data)
        && data.status == "new"
        && data.quoteAmount == null
        && data.followUpDate == ""
        && data.internalNotes == ""
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidAdminUpdate() {
      let data = request.resource.data;

      return hasAdminLeadFields(data)
        && hasValidCustomerFields(data)
        && hasValidPrivateFields(data)
        && hasValidProposalFields(data)
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "quoteAmount",
          "followUpDate",
          "internalNotes",
          "updatedAt",
          "projectTitle",
          "clientProjectSummary",
          "scopeOfWork",
          "deliverables",
          "officialPrice",
          "depositAmount",
          "remainingBalance",
          "estimatedTimeline",
          "proposedStartDate",
          "proposedCompletionDate",
          "includedRevisions",
          "paymentTerms",
          "additionalTerms",
          "proposalExpirationDate",
          "clientMessage",
          "proposalStatus",
          "proposalNumber",
          "proposalCreatedAt",
          "proposalSentAt",
          "proposalAcceptedAt",
          "lastClientEmailSubject",
          "lastClientEmailBody",
          "lastClientEmailSentAt"
        ]);
    }

    function isValidActivity() {
      let data = request.resource.data;

      return data.keys().hasAll([
        "type",
        "message",
        "createdAt",
        "createdBy",
        "createdByEmail"
      ])
      && data.keys().hasOnly([
        "type",
        "message",
        "createdAt",
        "createdBy",
        "createdByEmail"
      ])
      && data.type is string
      && data.type in [
        "proposal-created",
        "proposal-updated",
        "proposal-ready",
        "proposal-sent",
        "proposal-accepted",
        "proposal-declined",
        "proposal-expired",
        "email-generated",
        "email-sent",
        "status-changed",
        "quote-changed"
      ]
      && data.message is string
      && data.message.size() > 0
      && data.message.size() <= 1000
      && data.createdAt == request.time
      && data.createdBy == request.auth.uid
      && data.createdByEmail is string
      && data.createdByEmail.size() <= 254;
    }

    function isValidProposalCounter() {
      let data = request.resource.data;

      return data.keys().hasAll([
        "year",
        "lastNumber",
        "updatedAt",
        "updatedBy"
      ])
      && data.keys().hasOnly([
        "year",
        "lastNumber",
        "updatedAt",
        "updatedBy"
      ])
      && data.year is int
      && data.year >= 2000
      && data.year <= 3000
      && data.lastNumber is int
      && data.lastNumber >= 1
      && data.updatedAt == request.time
      && data.updatedBy == request.auth.uid;
    }

    match /leads/{leadId} {
      allow create: if isValidPublicLead();
      allow get, list: if isActiveAdmin();
      allow update: if isActiveAdmin()
        && isValidAdminUpdate();
      allow delete: if isActiveAdmin();

      match /activities/{activityId} {
        allow get, list: if isActiveAdmin();
        allow create: if isActiveAdmin()
          && exists(
            /databases/$(database)/documents/leads/$(leadId)
          )
          && isValidActivity();
        allow update: if false;
        allow delete: if isActiveAdmin();
      }
    }

    match /crmMeta/{documentId} {
      allow get: if isActiveAdmin();
      allow list, delete: if false;
      allow create, update: if isActiveAdmin()
        && isValidProposalCounter();
    }

    match /roles/{userUid} {
      allow get: if isSignedIn()
        && request.auth.uid == userUid;

      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
