rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/roles/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/roles/$(request.auth.uid)
        ).data.role == "admin"
        && get(
          /databases/$(database)/documents/roles/$(request.auth.uid)
        ).data.active == true;
    }

    function hasExpectedLeadFields(data) {
      return data.keys().hasAll([
        "name",
        "business",
        "email",
        "phone",
        "service",
        "message",
        "status",
        "quoteAmount",
        "followUpDate",
        "internalNotes",
        "createdAt",
        "updatedAt"
      ])
      && data.keys().hasOnly([
        "name",
        "business",
        "email",
        "phone",
        "service",
        "message",
        "status",
        "quoteAmount",
        "followUpDate",
        "internalNotes",
        "createdAt",
        "updatedAt",
        "lastEmailTemplate",
        "lastEmailSubject",
        "lastEmailBody",
        "lastEmailMarkedSentAt"
      ]);
    }

    function hasOnlyPublicLeadFields(data) {
      return data.keys().hasOnly([
        "name",
        "business",
        "email",
        "phone",
        "service",
        "message",
        "status",
        "quoteAmount",
        "followUpDate",
        "internalNotes",
        "createdAt",
        "updatedAt"
      ]);
    }

    function hasValidCustomerFields(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.business is string
        && data.business.size() > 0
        && data.business.size() <= 160
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.email.matches("^[^@]+@[^@]+[.][^@]+$")
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 40
        && data["service"] is string
        && data["service"] in [
          "App Development",
          "Website Development",
          "Social Media Management",
          "Content and Video Creation",
          "Digital Advertising",
          "Multiple Services"
        ]
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 5000;
    }

    function hasValidAdminFields(data) {
      return data.status is string
        && data.status in [
          "new",
          "contacted",
          "qualified",
          "quote-sent",
          "accepted",
          "in-progress",
          "completed",
          "lost"
        ]
        && (
          data.quoteAmount == null
          || (
            data.quoteAmount is number
            && data.quoteAmount >= 0
            && data.quoteAmount <= 100000000
          )
        )
        && data.followUpDate is string
        && data.followUpDate.size() <= 10
        && data.followUpDate.matches("^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.internalNotes is string
        && data.internalNotes.size() <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidStoredEmailFields(data) {
      let emailFields = [
        "lastEmailTemplate",
        "lastEmailSubject",
        "lastEmailBody",
        "lastEmailMarkedSentAt"
      ];

      return !data.keys().hasAny(emailFields)
        || (
          data.keys().hasAll(emailFields)
          && data.lastEmailTemplate is string
          && data.lastEmailTemplate in [
            "initial-response",
            "request-more-information",
            "send-quote",
            "follow-up",
            "quote-accepted",
            "request-project-content",
            "project-progress-update",
            "project-completed",
            "custom-message"
          ]
          && data.lastEmailSubject is string
          && data.lastEmailSubject.size() > 0
          && data.lastEmailSubject.size() <= 998
          && data.lastEmailBody is string
          && data.lastEmailBody.size() > 0
          && data.lastEmailBody.size() <= 20000
          && data.lastEmailMarkedSentAt is timestamp
        );
    }

    function isValidPublicLead() {
      let data = request.resource.data;

      return hasExpectedLeadFields(data)
        && hasOnlyPublicLeadFields(data)
        && hasValidCustomerFields(data)
        && data.status == "new"
        && data.quoteAmount == null
        && data.followUpDate == ""
        && data.internalNotes == ""
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidAdminUpdate() {
      let data = request.resource.data;

      return hasExpectedLeadFields(data)
        && hasValidCustomerFields(data)
        && hasValidAdminFields(data)
        && hasValidStoredEmailFields(data)
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "quoteAmount",
          "followUpDate",
          "internalNotes",
          "updatedAt"
        ]);
    }

    function isValidAdminEmailUpdate() {
      let data = request.resource.data;

      return hasExpectedLeadFields(data)
        && hasValidCustomerFields(data)
        && hasValidAdminFields(data)
        && hasValidStoredEmailFields(data)
        && data.lastEmailMarkedSentAt == request.time
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "lastEmailTemplate",
          "lastEmailSubject",
          "lastEmailBody",
          "lastEmailMarkedSentAt",
          "updatedAt"
        ]);
    }

    function isValidEmailCommunication() {
      let data = request.resource.data;

      return data.keys().hasAll([
        "type",
        "template",
        "subject",
        "body",
        "recipient",
        "markedSentAt",
        "createdBy"
      ])
      && data.keys().hasOnly([
        "type",
        "template",
        "subject",
        "body",
        "recipient",
        "markedSentAt",
        "createdBy"
      ])
      && data.type == "email"
      && data.template is string
      && data.template in [
        "initial-response",
        "request-more-information",
        "send-quote",
        "follow-up",
        "quote-accepted",
        "request-project-content",
        "project-progress-update",
        "project-completed",
        "custom-message"
      ]
      && data.subject is string
      && data.subject.size() > 0
      && data.subject.size() <= 998
      && data.body is string
      && data.body.size() > 0
      && data.body.size() <= 20000
      && data.recipient is string
      && data.recipient.size() > 3
      && data.recipient.size() <= 254
      && data.recipient.matches("^[^@]+@[^@]+[.][^@]+$")
      && data.markedSentAt == request.time
      && data.createdBy is string
      && data.createdBy == request.auth.uid;
    }

    match /leads/{leadId} {
      allow create: if isValidPublicLead();
      allow get, list: if isActiveAdmin();
      allow update: if isActiveAdmin()
        && (
          isValidAdminUpdate()
          || isValidAdminEmailUpdate()
        );
      allow delete: if isActiveAdmin();

      match /communications/{communicationId} {
        allow get, list: if isActiveAdmin();
        allow create: if isActiveAdmin()
          && isValidEmailCommunication();
        allow update, delete: if false;
      }
    }

    match /roles/{userUid} {
      allow get: if isSignedIn()
        && request.auth.uid == userUid;

      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
