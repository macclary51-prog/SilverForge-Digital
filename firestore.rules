rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.active == true;
    }

    function hasExpectedLeadFields(data) {
      return data.keys().hasAll([
        "name","business","email","phone","service","message","status",
        "quoteAmount","followUpDate","internalNotes","createdAt","updatedAt"
      ])
      && data.keys().hasOnly([
        "name","business","email","phone","service","message","status",
        "quoteAmount","followUpDate","internalNotes","createdAt","updatedAt",
        "lastEmailTemplate","lastEmailSubject","lastEmailBody","lastEmailMarkedSentAt","customerId"
      ]);
    }

    function hasOnlyPublicLeadFields(data) {
      return data.keys().hasOnly([
        "name","business","email","phone","service","message","status",
        "quoteAmount","followUpDate","internalNotes","createdAt","updatedAt","customerId"
      ]);
    }

    function hasValidCustomerFields(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.business is string
        && data.business.size() > 0
        && data.business.size() <= 160
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 254
        && data.email.matches("^[^@]+@[^@]+[.][^@]+$")
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 40
        && data["service"] is string
        && data["service"] in [
          "App Development",
          "Website Development",
          "Social Media Management",
          "Content and Video Creation",
          "Digital Advertising",
          "Multiple Services"
        ]
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 5000;
    }

    function hasValidAdminFields(data) {
      return data.status is string
        && data.status in [
          "new","contacted","qualified","quote-sent",
          "accepted","in-progress","completed","lost"
        ]
        && (
          data.quoteAmount == null
          || (
            data.quoteAmount is number
            && data.quoteAmount >= 0
            && data.quoteAmount <= 100000000
          )
        )
        && data.followUpDate is string
        && data.followUpDate.size() <= 10
        && data.followUpDate.matches("^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.internalNotes is string
        && data.internalNotes.size() <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidStoredEmailFields(data) {
      let emailFields = [
        "lastEmailTemplate",
        "lastEmailSubject",
        "lastEmailBody",
        "lastEmailMarkedSentAt"
      ];

      return !data.keys().hasAny(emailFields)
        || (
          data.keys().hasAll(emailFields)
          && data.lastEmailTemplate is string
          && data.lastEmailTemplate in [
            "initial-response",
            "request-information",
            "send-quote",
            "follow-up",
            "quote-accepted",
            "request-content",
            "progress-update",
            "project-completed",
            "custom"
          ]
          && data.lastEmailSubject is string
          && data.lastEmailSubject.size() > 0
          && data.lastEmailSubject.size() <= 998
          && data.lastEmailBody is string
          && data.lastEmailBody.size() > 0
          && data.lastEmailBody.size() <= 20000
          && data.lastEmailMarkedSentAt is timestamp
        );
    }

    function isValidPublicLead() {
      let data = request.resource.data;
      return hasExpectedLeadFields(data)
        && hasOnlyPublicLeadFields(data)
        && hasValidCustomerFields(data)
        && data.keys().hasAll(["customerId"])
        && ((!isSignedIn() && data.customerId == null)
          || (isSignedIn() && data.customerId == request.auth.uid
            && data.email == request.auth.token.email))
        && data.status == "new"
        && data.quoteAmount == null
        && data.followUpDate == ""
        && data.internalNotes == ""
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidAdminUpdate() {
      let data = request.resource.data;
      return hasExpectedLeadFields(data)
        && hasValidCustomerFields(data)
        && hasValidAdminFields(data)
        && hasValidStoredEmailFields(data)
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "status","quoteAmount","followUpDate","internalNotes","updatedAt"
        ]);
    }

    function isValidAdminEmailUpdate() {
      let data = request.resource.data;
      return hasExpectedLeadFields(data)
        && hasValidCustomerFields(data)
        && hasValidAdminFields(data)
        && hasValidStoredEmailFields(data)
        && data.lastEmailMarkedSentAt == request.time
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "lastEmailTemplate","lastEmailSubject","lastEmailBody",
          "lastEmailMarkedSentAt","updatedAt"
        ]);
    }

    // Linking changes ownership only; all existing lead content is preserved.
    function isValidClientLink() {
      let data = request.resource.data;
      return data.diff(resource.data).affectedKeys().hasOnly(["customerId", "updatedAt"])
        && data.updatedAt == request.time
        && (data.customerId == null || (validText(data.customerId, 1, 128)
          && get(/databases/$(database)/documents/users/$(data.customerId)).data.role == "customer"));
    }

    function isValidEmailCommunication() {
      let data = request.resource.data;
      return data.keys().hasAll([
        "type","template","subject","body","recipient","markedSentAt","createdBy"
      ])
      && data.keys().hasOnly([
        "type","template","subject","body","recipient","markedSentAt","createdBy"
      ])
      && data.type == "email"
      && data.template is string
      && data.template in [
        "initial-response",
        "request-information",
        "send-quote",
        "follow-up",
        "quote-accepted",
        "request-content",
        "progress-update",
        "project-completed",
        "custom"
      ]
      && data.subject is string
      && data.subject.size() > 0
      && data.subject.size() <= 998
      && data.body is string
      && data.body.size() > 0
      && data.body.size() <= 20000
      && data.recipient is string
      && data.recipient.size() > 3
      && data.recipient.size() <= 254
      && data.recipient.matches("^[^@]+@[^@]+[.][^@]+$")
      && data.markedSentAt == request.time
      && data.createdBy is string
      && data.createdBy == request.auth.uid;
    }

    function hasValidCustomerProfileFields(data) {
      return data.keys().hasAll([
        "uid","name","business","email","role","status","createdAt","updatedAt"
      ])
      && data.keys().hasOnly([
        "uid","name","business","email","role","status","createdAt","updatedAt"
      ])
      && data.uid is string
      && data.uid.size() > 0
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 120
      && data.business is string
      && data.business.size() <= 160
      && data.email is string
      && data.email.size() > 3
      && data.email.size() <= 254
      && data.email.matches("^[^@]+@[^@]+[.][^@]+$")
      && data.role == "customer"
      && data.status == "active"
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCustomerProfileCreate(userUid) {
      let data = request.resource.data;
      return isSignedIn()
        && request.auth.uid == userUid
        && request.auth.token.email is string
        && hasValidCustomerProfileFields(data)
        && data.uid == userUid
        && data.email == request.auth.token.email
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidCustomerProfileUpdate(userUid) {
      let data = request.resource.data;
      return isSignedIn()
        && request.auth.uid == userUid
        && hasValidCustomerProfileFields(data)
        && data.uid == resource.data.uid
        && data.email == resource.data.email
        && data.role == resource.data.role
        && data.status == resource.data.status
        && data.createdAt == resource.data.createdAt
        && data.updatedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly([
          "name","business","updatedAt"
        ]);
    }

    match /leads/{leadId} {
      allow create: if isValidPublicLead() && hasCurrentQuoteSummary(leadId, request.resource.data);
      // A Firestore read returns every field. Private CRM notes/drafts stay admin-only.
      // Customers read the strictly validated customerQuotes projection instead.
      allow get, list: if isActiveAdmin();
      allow update: if isActiveAdmin()
        && (isValidAdminUpdate() || isValidAdminEmailUpdate() || isValidClientLink())
        && hasCurrentQuoteSummary(leadId, request.resource.data);
      allow delete: if isActiveAdmin()
        && !existsAfter(/databases/$(database)/documents/customerQuotes/$(leadId));

      match /communications/{communicationId} {
        allow get, list: if isActiveAdmin();
        allow create: if isActiveAdmin() && isValidEmailCommunication();
        allow update, delete: if false;
      }
    }

    match /users/{userUid} {
      allow create: if isValidCustomerProfileCreate(userUid);

      allow get: if isSignedIn()
        && (request.auth.uid == userUid || isActiveAdmin());

      allow list: if isActiveAdmin();

      allow update: if isActiveAdmin()
        || isValidCustomerProfileUpdate(userUid);

      allow delete: if isActiveAdmin();
    }

    match /roles/{userUid} {
      allow get: if isSignedIn() && request.auth.uid == userUid;
      allow list, create, update, delete: if false;
    }

    function validText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum
        && (minimum == 0 || value.matches("[\\s\\S]*[^\\s][\\s\\S]*"));
    }

    function validEmail(value) {
      return validText(value, 4, 254) && value.matches("^[^@\\s]+@[^@\\s]+[.][^@\\s]+$");
    }

    function summaryMatches(summary, lead) {
      return summary.keys().hasAll(["customerId","service","business","status","quoteAmount","createdAt"])
        && summary.keys().hasOnly(["customerId","service","business","status","quoteAmount","createdAt"])
        && summary.customerId == lead.customerId
        && summary["service"] == lead["service"] && summary.business == lead.business
        && summary.status == lead.status && summary.quoteAmount == lead.quoteAmount
        && summary.createdAt == lead.createdAt;
    }

    function hasCurrentQuoteSummary(leadId, lead) {
      return ((!lead.keys().hasAny(["customerId"]) || lead.customerId == null)
          && !existsAfter(/databases/$(database)/documents/customerQuotes/$(leadId)))
        || (lead.get("customerId", null) != null
          && summaryMatches(getAfter(/databases/$(database)/documents/customerQuotes/$(leadId)).data, lead));
    }

    match /customerQuotes/{leadId} {
      allow read: if isActiveAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn()
        && (isActiveAdmin() || (
          request.resource.data.customerId == request.auth.uid
          && !exists(/databases/$(database)/documents/leads/$(leadId))
          && getAfter(/databases/$(database)/documents/leads/$(leadId)).data.createdAt == request.time
        ))
        && summaryMatches(request.resource.data, getAfter(/databases/$(database)/documents/leads/$(leadId)).data);
      allow update: if isActiveAdmin()
        && summaryMatches(request.resource.data, getAfter(/databases/$(database)/documents/leads/$(leadId)).data);
      allow delete: if isActiveAdmin()
        && (!existsAfter(/databases/$(database)/documents/leads/$(leadId))
          || getAfter(/databases/$(database)/documents/leads/$(leadId)).data.get("customerId", null) == null);
    }

    match /users/{clientUid}/adminNotes/{noteId} {
      function validNote() {
        let data = request.resource.data;
        return data.keys().hasAll(["text", "createdAt", "updatedAt", "createdBy", "createdByEmail"])
          && data.keys().hasOnly(["text", "createdAt", "updatedAt", "createdBy", "createdByEmail"])
          && validText(data.text, 1, 10000) && data.updatedAt == request.time;
      }
      allow read, delete: if isActiveAdmin();
      allow create: if isActiveAdmin() && validNote()
        && get(/databases/$(database)/documents/users/$(clientUid)).data.role == "customer"
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if isActiveAdmin() && validNote()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "updatedAt"]);
    }

    function isConversationClient(clientUid) {
      return isSignedIn() && request.auth.uid == clientUid && !isActiveAdmin()
        && get(/databases/$(database)/documents/users/$(clientUid)).data.role == "customer";
    }

    match /clientConversations/{clientUid} {
      function participant() { return isActiveAdmin() || isConversationClient(clientUid); }
      function validConversationSend() {
        let data = request.resource.data;
        let profile = get(/databases/$(database)/documents/users/$(clientUid)).data;
        let sent = getAfter(/databases/$(database)/documents/clientConversations/$(clientUid)/messages/$(data.lastMessageId)).data;
        let admin = isActiveAdmin();
        return participant() && profile.role == "customer"
          && data.keys().hasAll(["clientId","clientName","clientEmail","createdAt","updatedAt","lastMessageAt","lastMessagePreview","lastSenderRole","lastMessageId","lastCustomerMessageAt","lastAdminMessageAt","adminReadAt","clientReadAt"])
          && data.keys().hasOnly(["clientId","clientName","clientEmail","createdAt","updatedAt","lastMessageAt","lastMessagePreview","lastSenderRole","lastMessageId","lastCustomerMessageAt","lastAdminMessageAt","adminReadAt","clientReadAt"])
          && data.clientId == clientUid && data.clientName == profile.name && data.clientEmail == profile.email
          && data.updatedAt == request.time && data.lastMessageAt == request.time
          && validText(data.lastMessageId, 1, 128)
          && !exists(/databases/$(database)/documents/clientConversations/$(clientUid)/messages/$(data.lastMessageId))
          && sent.createdAt == request.time && sent.senderId == request.auth.uid
          && data.lastMessagePreview == sent.message && data.lastSenderRole == sent.senderRole
          && ((admin && data.lastSenderRole == "admin" && data.lastAdminMessageAt == request.time)
            || (!admin && data.lastSenderRole == "customer" && data.lastCustomerMessageAt == request.time));
      }
      function preservesConversation() {
        let data = request.resource.data;
        return data.createdAt == resource.data.createdAt
          && data.adminReadAt == resource.data.adminReadAt && data.clientReadAt == resource.data.clientReadAt
          && ((isActiveAdmin() && data.lastCustomerMessageAt == resource.data.lastCustomerMessageAt)
            || (!isActiveAdmin() && data.lastAdminMessageAt == resource.data.lastAdminMessageAt));
      }
      function validReadReceipt() {
        let data = request.resource.data;
        return (isActiveAdmin()
            && data.diff(resource.data).affectedKeys().hasOnly(["adminReadAt"])
            && data.adminReadAt is timestamp && data.adminReadAt >= resource.data.adminReadAt
            && data.adminReadAt <= resource.data.lastCustomerMessageAt)
          || (isConversationClient(clientUid)
            && data.diff(resource.data).affectedKeys().hasOnly(["clientReadAt"])
            && data.clientReadAt is timestamp && data.clientReadAt >= resource.data.clientReadAt
            && data.clientReadAt <= resource.data.lastAdminMessageAt);
      }
      allow get: if participant();
      allow list: if isActiveAdmin();
      allow create: if validConversationSend()
        && request.resource.data.createdAt == request.time
        && request.resource.data.adminReadAt == timestamp.value(0)
        && request.resource.data.clientReadAt == timestamp.value(0)
        && ((isActiveAdmin() && request.resource.data.lastCustomerMessageAt == timestamp.value(0))
          || (!isActiveAdmin() && request.resource.data.lastAdminMessageAt == timestamp.value(0)));
      allow update: if (validConversationSend() && preservesConversation()) || validReadReceipt();
      allow delete: if false;

      match /messages/{messageId} {
        function validClientMessage() {
          let data = request.resource.data;
          let parent = getAfter(/databases/$(database)/documents/clientConversations/$(clientUid)).data;
          return participant()
            && data.keys().hasAll(["senderId","senderRole","senderName","message","createdAt","readByAdmin","readByClient"])
            && data.keys().hasOnly(["senderId","senderRole","senderName","message","createdAt","readByAdmin","readByClient"])
            && data.senderId == request.auth.uid && validText(data.message, 1, 5000)
            && data.createdAt == request.time && parent.lastMessageId == messageId && parent.updatedAt == request.time
            && ((isActiveAdmin() && data.senderRole == "admin" && data.senderName == "SilverForge"
                && data.readByAdmin == true && data.readByClient == false)
              || (isConversationClient(clientUid) && data.senderRole == "customer"
                && data.senderName == get(/databases/$(database)/documents/users/$(clientUid)).data.name
                && data.readByAdmin == false && data.readByClient == true));
        }
        allow read: if participant();
        allow create: if validClientMessage();
        // Only the recipient can mark a received message read, never unread.
        allow update: if (isActiveAdmin() && resource.data.senderRole == "customer"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readByAdmin"])
            && request.resource.data.readByAdmin == true)
          || (isConversationClient(clientUid) && resource.data.senderRole == "admin"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readByClient"])
            && request.resource.data.readByClient == true);
        allow delete: if false;
      }
    }

    function validContactCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(["name","email","category","subject","message","status","createdAt","updatedAt"])
        && data.keys().hasOnly(["name","email","category","subject","message","status","createdAt","updatedAt"])
        && validText(data.name, 1, 120) && validEmail(data.email)
        && data.category in ["General Question","Billing Question","Partnership / Business","Existing Project Question","Other"]
        && validText(data.subject, 1, 200) && validText(data.message, 1, 5000)
        && data.status == "new" && data.createdAt == request.time && data.updatedAt == request.time;
    }

    match /contactMessages/{messageId} {
      allow create: if validContactCreate();
      allow read, delete: if isActiveAdmin();
      allow update: if isActiveAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","updatedAt"])
        && request.resource.data.status in ["new","closed"]
        && request.resource.data.updatedAt == request.time;
    }

    function ownsTicket(ticket) {
      return isSignedIn() && ticket.ownerId == request.auth.uid;
    }

    function validTicketCreate() {
      let data = request.resource.data;
      return isSignedIn() && !isActiveAdmin()
        && data.keys().hasAll(["ownerId","ownerEmail","ownerName","type","projectName","title","details","status","priority","createdAt","updatedAt","lastMessageAt"])
        && data.keys().hasOnly(["ownerId","ownerEmail","ownerName","type","projectName","title","details","status","priority","createdAt","updatedAt","lastMessageAt"])
        && data.ownerId == request.auth.uid && data.ownerEmail == request.auth.token.email
        && validEmail(data.ownerEmail) && validText(data.ownerName, 1, 254)
        && data.type in ["bug-fix","redesign-change","feature-request","content-update","maintenance","technical-issue","billing","other"]
        && validText(data.projectName, 1, 160) && validText(data.title, 1, 200) && validText(data.details, 1, 5000)
        && data.status == "open" && data.priority == "normal"
        && data.createdAt == request.time && data.updatedAt == request.time && data.lastMessageAt == request.time;
    }

    function validTicketActivity() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt","lastMessageAt"])
        && request.resource.data.updatedAt == request.time && request.resource.data.lastMessageAt == request.time;
    }

    match /supportTickets/{ticketId} {
      allow create: if validTicketCreate();
      allow read: if isActiveAdmin() || ownsTicket(resource.data);
      allow update: if (ownsTicket(resource.data) && !isActiveAdmin() && validTicketActivity())
        || (isActiveAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","priority","updatedAt","lastMessageAt"])
          && request.resource.data.status in ["open","in-review","working","resolved","closed"]
          && request.resource.data.priority in ["low","normal","high","urgent"]
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.lastMessageAt == resource.data.lastMessageAt || request.resource.data.lastMessageAt == request.time));
      allow delete: if isActiveAdmin();

      match /messages/{messageId} {
        function parentTicket() {
          return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        function validMessage() {
          let data = request.resource.data;
          let afterTicket = getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
          return isSignedIn()
            && exists(/databases/$(database)/documents/supportTickets/$(ticketId))
            && data.keys().hasAll(["senderId","senderRole","senderName","message","createdAt"])
            && data.keys().hasOnly(["senderId","senderRole","senderName","message","createdAt"])
            && data.senderId == request.auth.uid
            && validText(data.senderName, 1, 254) && validText(data.message, 1, 5000)
            && data.createdAt == request.time
            && afterTicket.updatedAt == request.time && afterTicket.lastMessageAt == request.time
            && ((isActiveAdmin() && data.senderRole == "admin" && data.senderName == "SilverForge")
              || (!isActiveAdmin() && ownsTicket(parentTicket()) && data.senderRole == "customer"));
        }
        allow read: if isActiveAdmin() || ownsTicket(parentTicket());
        allow create: if validMessage();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
